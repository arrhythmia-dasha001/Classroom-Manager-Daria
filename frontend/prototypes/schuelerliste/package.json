{
  "name": "schuelerliste",
  "version": "1.0.0",
  "private": true,
  "description": "Schülerübersicht mit Filtern und Sortieren (LF10A UW4)",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write js tests",
    "format:check": "prettier --check js tests",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "js/filter.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1"
  }
}
